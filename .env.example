# Paths and limits
SHIMLINE_DB_PATH=./intake.db
SHIMLINE_UPLOADS_DIR=./uploads
MAX_UPLOAD_MB=20
RETENTION_DAYS_AFTER_CLOSE=30
RETENTION_DAYS_UNCLOSED=90

# Application security. Generate unique values; never commit real secrets.
SHIMLINE_SECRET_KEY=replace-with-at-least-32-random-characters
ADMIN_COOKIE_SECURE=1

# Client-facing calendar
SHIMLINE_BUSINESS_TZ=America/Toronto
SHIMLINE_BUSINESS_PROVINCE=ON

# Background work. Keep disabled unless a huey worker is running.
SHIMLINE_ASYNC_JOBS_ENABLED=0
SHIMLINE_TASK_DB_PATH=./shimline_tasks.db
# Optional worker-only fallback for scanned images: none or paddle.
SHIMLINE_INVOICE_OCR_BACKEND=none

# Metrics are private. Loopback works without a token; remote access requires it.
SHIMLINE_METRICS_ENABLED=0
SHIMLINE_METRICS_TOKEN=replace-with-a-random-bearer-token

# Consent-gated, first-party website measurement. Set to 1 only when the
# matching static site build is published with SHIMLINE_MEASUREMENT_ENABLED=1.
SHIMLINE_MEASUREMENT_ENABLED=0
SHIMLINE_MEASUREMENT_RETENTION_DAYS=90

# SMTP notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=replace-me
NOTIFY_TO=
NOTIFY_FROM=

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me
PRICE_AMOUNT=19900
PRICE_CURRENCY=CAD
UPLOAD_TOKEN_HOURS=72

# QuickBooks Online
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=replace-me
QBO_REDIRECT_URI=http://localhost:8000/qbo/callback
QBO_ENVIRONMENT=sandbox
QBO_TOKEN_KEY=replace-me
QBO_AUTHORIZE_ORIGIN=https://appcenter.intuit.com

PORTAL_BASE_URL=http://localhost:8000
SHIMLINE_STATIC_VERSION=
